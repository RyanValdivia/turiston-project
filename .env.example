DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-to-a-long-random-string"

# Ejecutable de Python usado para correr predictor/train.py y predictor/predict.py.
# Cambiar a "python3" si el sistema no tiene "python" en el PATH.
PYTHON_BIN="python"

# --- Asistente de IA (restora) ---
# Interruptor general del asistente conversacional. "false" lo desactiva por completo.
ASISTENTE_HABILITADO="true"

# Proveedor principal: Google Gemini. Obtén una key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Proveedor de respaldo (open source vía Groq). Key gratis en https://console.groq.com/keys
# Si Gemini no responde, el asistente usa Groq automáticamente.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Si ni Gemini ni Groq están disponibles, el asistente cae a un modo guiado
# determinista (pregunta-respuesta con validación), por lo que SIEMPRE funciona.

