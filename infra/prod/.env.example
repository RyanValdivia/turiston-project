# Copy to .env in this same directory on the VPS (never commit the real file).

# Domain this stack is served on (wildcard cert *.rvaldiviase.com already covers it).
TRAEFIK_HOST=turiston.rvaldiviase.com
TRAEFIK_NETWORK=traefik_proxy
TRAEFIK_CERT_RESOLVER=cloudflare

# Generate with: openssl rand -base64 48
AUTH_SECRET=

# --- Asistente de IA (restora) ---
ASISTENTE_HABILITADO=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
